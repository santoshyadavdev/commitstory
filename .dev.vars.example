# Cloudflare Workers local development secrets
# Copy this file to .dev.vars and fill in the values
# .dev.vars is git-ignored and should never be committed

# Secret used to sign and encrypt session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Generative AI API key for story generation.
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# GitHub OAuth App client ID.
# Create an OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=

# GitHub OAuth App client secret.
# Found in the same GitHub OAuth App settings page as GITHUB_CLIENT_ID.
GITHUB_CLIENT_SECRET=

# GitHub OAuth callback URL.
# For local Wrangler dev (port 8787 is Wrangler's default):
GITHUB_CALLBACK_URL=http://localhost:8787/api/auth/github/callback
