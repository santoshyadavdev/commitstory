# GitHub OAuth App credentials
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The callback URL registered in your GitHub OAuth App
# For local development: http://localhost:4000/api/auth/github/callback
GITHUB_CALLBACK_URL=

# A long, random string used to sign session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Google AI API key for Gemini story generation
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=
